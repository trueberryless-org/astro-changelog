---
import type { Page } from "astro";

import type { Release as ReleaseEntry } from "../libs/release";

import Pagination from "./Pagination.astro";
import Release from "./Release.astro";
import Search from "./Search.astro";

interface Props {
  packageName: string;
  page: Page<ReleaseEntry>;
  title: string;
}

const { packageName, page, title } = Astro.props;
---

<main>
  <h1 class="page_title">{title}</h1>
  <Search {packageName} />
  <hr />
  <ul class="posts" transition:name="post">
    {page.data.map((release) => (
      <li class="post">
        <Release isLink {release} />
      </li>
    ))}
  </ul>
  <Pagination {page} />
</main>
